{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmd.run-gate/v1",
  "type": "object",
  "required": ["schema", "goal", "scope", "actor", "authority_source", "evidence_ref", "unknown", "allowed_side_effects"],
  "properties": {
    "schema": {"const": "openmd.run-gate/v1"},
    "goal": {"type": "string", "minLength": 1},
    "scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "actor": {"enum": ["user", "dispatcher", "worker"]},
    "authority_source": {"type": "string", "minLength": 1},
    "authority_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "evidence_ref": {"type": "string", "minLength": 1},
    "supersedes": {"type": "string"},
    "unknown": {"type": "boolean"},
    "allowed_side_effects": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "additionalProperties": false
}
