# Same bytes on Windows, macOS and Linux: LF in the repo and in working trees.
* text=auto eol=lf

# Windows-only launchers keep CRLF.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Shell scripts and git hooks must stay LF or sh refuses them.
*.sh text eol=lf
scripts/hooks/* text eol=lf

*.png binary
*.jpg binary
*.ico binary
*.pdf binary
*.onnx binary
