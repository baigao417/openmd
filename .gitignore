# Publish only the audited product roots and public metadata.
/*
!/src/
!/tests/
!/scripts/
!/integrations/
!/docs/
!/LICENSES/
!/README.md
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/pyproject.toml
!/.gitignore
!/.env.example
/docs/*
!/docs/fixtures/

# Never publish runtime state, secrets, binary inputs or tool installations.
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
node_modules/
dist/
build/
out/
outputs/
logs/
runs/
agent-runs/
.env
.env.*
!.env.example
*cookie*.json
*cookie*.txt
*cookie*.sqlite*
*token*.json
*session*.json
*credential*.json
*.pem
*.key
*.db
*.sqlite*
*.log
*.jsonl
*.zip
*.crx
*.exe
*.mp4
*.mp3
*.m4a
*.wav
*.pdf
*.docx
*.pptx
*.xlsx
AGENTS.md
CLAUDE.md
handoff.md
PROJECT_STATUS.md
lessons.md
.trellis/
.ace-tool/
.agents/
.codex/
.claude/
.cursor/
prompts/
raw/
/integrations/opencli/*/*.js
